     if (GetRemainingSize() < 1024 * 1024) {
         ClearCache();
+        g_full_cache_clears.fetch_add(1, std::memory_order_relaxed);
+        t_full_cache_clears++;
     }
+    const std::size_t emit_start = static_cast<std::size_t>(code.offset());
 
     UnprotectCodeMemory();
 
