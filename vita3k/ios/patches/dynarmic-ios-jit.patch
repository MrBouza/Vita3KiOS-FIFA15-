+// debugger must prepare executable memory up front). Implemented by the host application.
+extern "C" void* oaknut_ios_jit_alloc(std::size_t size, void** writable);
+extern "C" void oaknut_ios_jit_free(void* executable, std::size_t size);
+#endif
+
 namespace oaknut {
 
 class CodeBlock {
@@ -32,7 +40,9 @@ public:
         m_memory = (std::uint32_t*)VirtualAlloc(nullptr, size, MEM_COMMIT, PAGE_EXECUTE_READWRITE);
