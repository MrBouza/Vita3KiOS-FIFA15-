+        void* writable = nullptr;
+        m_memory = (std::uint32_t*)oaknut_ios_jit_alloc(size, &writable);
+        m_wmem = (std::uint32_t*)writable;
 #    else
         m_memory = (std::uint32_t*)mmap(nullptr, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_ANON | MAP_PRIVATE | MAP_JIT, -1, 0);
 #    endif
@@ -46,6 +56,8 @@ public:
 
         if (m_memory == nullptr)
             throw std::bad_alloc{};
+        if (m_wmem == nullptr)
+            m_wmem = m_memory;
     }
 
     ~CodeBlock()
@@ -55,6 +67,8 @@ public:
 
 #if defined(_WIN32)
         VirtualFree((void*)m_memory, 0, MEM_RELEASE);
+#elif defined(__APPLE__) && TARGET_OS_IPHONE
+        oaknut_ios_jit_free(m_memory, m_size);
 #else
         munmap(m_memory, m_size);
 #endif
@@ -65,14 +79,23 @@ public:
     CodeBlock(CodeBlock&&) = delete;
     CodeBlock& operator=(CodeBlock&&) = delete;
 
+    // Address code executes from
     std::uint32_t* ptr() const
     {
         return m_memory;
     }
 
+    // Address code is written through (a separate alias of ptr() on iOS, the same address elsewhere)
+    std::uint32_t* wptr() const
+    {
+        return m_wmem;
+    }
+
     void protect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+        // Writable and executable views are separate mappings, nothing to switch
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(1);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_EXEC);
@@ -81,7 +104,9 @@ public:
 
     void unprotect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+        // Writable and executable views are separate mappings, nothing to switch
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(0);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_WRITE);
@@ -137,6 +162,7 @@ public:
 
 protected:
     std::uint32_t* m_memory;
+    std::uint32_t* m_wmem = nullptr;
     std::size_t m_size = 0;
 };
 
